[Unit]
Description=THE ARK NANO-MINI offline boot smoke
After=docker.service local-fs.target
Wants=docker.service

[Service]
Type=oneshot
EnvironmentFile=-/etc/endworld/profile.env
ExecStart=/opt/endworld/runtime/offline-smoke.sh
TimeoutStartSec=330
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
