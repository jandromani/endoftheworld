[Unit]
Description=ENDWORLD frozen capability stack
After=docker.service local-fs.target
Requires=docker.service
RequiresMountsFor=/srv/endworld

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=ENDWORLD_VAULT=/srv/endworld
EnvironmentFile=-/etc/endworld/profile.env
ExecStart=/opt/endworld/runtime/start-stack.sh
ExecStop=/opt/endworld/runtime/stop-stack.sh
TimeoutStartSec=0
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
